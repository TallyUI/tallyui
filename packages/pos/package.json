{
  "name": "@tallyui/pos",
  "version": "3.16.0",
  "type": "module",
  "description": "Shared POS business logic for Tally UI — tax, orders, payments, discounts, receipts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test-helper.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TallyUI/tallyui.git",
    "directory": "packages/pos"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/mustache": "^4.2.6",
    "@xmldom/xmldom": "0.9.12",
    "dompurify": "^3.4.17",
    "mustache": "^4.2.0"
  },
  "peerDependencies": {
    "@tallyui/core": "workspace:^",
    "react": ">=18",
    "rxdb": "~17.5.0",
    "rxjs": ">=7"
  },
  "devDependencies": {
    "@tallyui/core": "workspace:*",
    "@types/react": ">=18",
    "react": "^19.2.4",
    "rxdb": "17.5.0",
    "rxjs": "7.8.2",
    "@tallyui/connector-medusa": "workspace:*",
    "@tallyui/connector-woocommerce": "workspace:*",
    "@tallyui/database": "workspace:*"
  }
}
