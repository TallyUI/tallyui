{
  "name": "@tallyui/components",
  "version": "1.0.0",
  "type": "module",
  "description": "Universal POS UI components for Tally UI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TallyUI/tallyui.git",
    "directory": "packages/components"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\""
  },
  "peerDependencies": {
    "@tallyui/core": "workspace:*",
    "@tallyui/primitives": "workspace:*",
    "@tallyui/theme": "workspace:*",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=15"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "@tallyui/pos": "workspace:*"
  },
  "devDependencies": {
    "@tallyui/connector-medusa": "workspace:*",
    "@tallyui/connector-vendure": "workspace:*",
    "@tallyui/connector-woocommerce": "workspace:*",
    "@tallyui/mock-api": "workspace:*",
    "@types/react": ">=18",
    "react": "^19.2.4",
    "react-native-svg": "15.12.1"
  }
}
