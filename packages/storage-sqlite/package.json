{
  "name": "@tallyui/storage-sqlite",
  "version": "3.4.0",
  "type": "module",
  "description": "RxDB Premium SQLite storage for a synchronous SQLite handle (expo-sqlite)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "bin": {
    "tallyui-build-sqlite-worker": "./scripts/build-web-worker.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./src/index.ts"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "source": "./src/web/index.ts"
    },
    "./web-worker": {
      "types": "./dist/web/worker.d.ts",
      "import": "./dist/web/worker.js",
      "source": "./src/web/worker.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-helper.ts",
    "scripts/*.mjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TallyUI/tallyui.git",
    "directory": "packages/storage-sqlite"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.expo-handle.json",
    "test": "vitest run"
  },
  "dependencies": {
    "rxdb": "17.5.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tallyui/core": "workspace:^",
    "esbuild": "0.27.3",
    "expo-sqlite": "16.0.10",
    "rxdb-premium": "17.5.0"
  },
  "peerDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@tallyui/core": "workspace:^",
    "expo-sqlite": ">=15.0.0",
    "rxdb-premium": "17.5.0"
  },
  "peerDependenciesMeta": {
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    }
  }
}
