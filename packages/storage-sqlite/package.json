{
  "name": "@tallyui/storage-sqlite",
  "version": "0.2.0",
  "type": "module",
  "description": "RxDB Premium SQLite storage for a synchronous SQLite handle (expo-sqlite)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./src/index.ts"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "source": "./src/web/index.ts"
    },
    "./web-worker": {
      "types": "./dist/web/worker.d.ts",
      "import": "./dist/web/worker.js",
      "source": "./src/web/worker.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TallyUI/tallyui.git",
    "directory": "packages/storage-sqlite"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "rxdb": "16.21.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "rxdb-premium": "16.21.1"
  },
  "peerDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "expo-sqlite": ">=15.0.0",
    "rxdb-premium": "16.21.1"
  },
  "peerDependenciesMeta": {
    "@sqlite.org/sqlite-wasm": { "optional": true },
    "expo-sqlite": { "optional": true }
  }
}
