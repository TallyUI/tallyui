{
  "name": "@tallyui/web",
  "version": "0.0.0",
  "private": true,
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 115",
    "safari >= 17",
    "ios_saf >= 17"
  ],
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "links:check": "linkinator http://localhost:3000 --recurse --skip '^(?!http://localhost:3000)'",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint"
  },
  "dependencies": {
    "fumadocs-core": "16.6.5",
    "fumadocs-mdx": "14.2.8",
    "fumadocs-ui": "16.6.5",
    "lucide-react": "^0.570.0",
    "next": "16.1.6",
    "posthog-js": "1.434.17",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@tallyui/components": "workspace:*",
    "@tallyui/connector-medusa": "workspace:*",
    "@tallyui/connector-woocommerce": "workspace:*",
    "@tallyui/core": "workspace:*",
    "@tallyui/theme": "workspace:*",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "eslint-config-next": "16.1.6",
    "eslint": "^9.39.5",
    "linkinator": "8.1.0"
  }
}