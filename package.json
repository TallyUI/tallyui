{
  "private": true,
  "name": "@tallyui/monorepo",
  "scripts": {
    "dev": "turbo dev",
    "dev:demo": "turbo dev --filter=@tallyui/demo",
    "dev:web": "turbo dev --filter=@tallyui/web",
    "dev:mock-api": "turbo dev --filter=@tallyui/mock-api",
    "build": "turbo build",
    "test": "vitest run",
    "check:deps": "node scripts/check-workspace-deps.mjs",
    "check:release-plan": "node scripts/check-release-plan.mjs",
    "check:core-dist": "node scripts/check-core-dist.mjs",
    "changelog:docs": "node scripts/build-changelog.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "lint": "turbo lint && pnpm -s lint:code",
    "lint:code": "eslint packages connectors --max-warnings=0 --pass-on-unpruned-suppressions",
    "knip": "knip",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "test:e2e:web": "playwright test",
    "test:e2e:native": "maestro test .maestro/flows/"
  },
  "packageManager": "pnpm@11.27.0",
  "dependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.8.3"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "jsdom": "^28.1.0",
    "knip": "^6.41.0",
    "next": "16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-native-web": "0.21.2",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
